local function CreateBillboard(adornee, name, text, color, offset)
    if adornee:FindFirstChild(name) then return adornee[name] end
    local gui = Instance.new("BillboardGui")
    gui.Name = name
    gui.Adornee = adornee
    gui.Size = UDim2.new(0, 200, 0, 40)
    gui.StudsOffset = offset or Vector3.new(0, 2.5, 0)
    gui.AlwaysOnTop = true
    gui.Parent = adornee

    local label = Instance.new("TextLabel")
    label.Name = "TextLabel"
    label.BackgroundTransparency = 1
    label.Size = UDim2.new(1, 0, 1, 0)
    label.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0.5
    label.TextScaled = true
    label.Font = Enum.Font.GothamBold
    label.Text = text or ""
    label.Parent = gui
    return gui
end

task.spawn(function()
    while task.wait(1) do
        -- Player ESP
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = player.Character.HumanoidRootPart
                if getgenv().ESPPlayer then
                    local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - hrp.Position).Magnitude)
                    local esp = CreateBillboard(hrp, "PlayerESP", player.Name .. " [" .. dist .. "m]", Color3.fromRGB(0, 255, 120))
                    esp.TextLabel.Text = player.Name .. " [" .. dist .. "m]\nHP: " .. math.floor(player.Character.Humanoid.Health)
                elseif hrp:FindFirstChild("PlayerESP") then
                    hrp.PlayerESP:Destroy()
                end
            end
        end

        -- Chest ESP
        for _, chest in ipairs(CollectionService:GetTagged("_ChestTagged")) do
            if getgenv().ChestESP and not chest:GetAttribute("IsDisabled") then
                local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - chest:GetPivot().Position).Magnitude)
                local esp = CreateBillboard(chest, "ChestESP", "Chest [" .. dist .. "m]", Color3.fromRGB(255, 215, 0))
                esp.TextLabel.Text = "Chest\n" .. dist .. "m"
            elseif chest:FindFirstChild("ChestESP") then
                chest.ChestESP:Destroy()
            end
        end

        -- Fruit ESP
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Tool") and string.find(obj.Name, "Fruit") and obj:FindFirstChild("Handle") then
                if getgenv().DevilFruitESP then
                    local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - obj.Handle.Position).Magnitude)
                    local esp = CreateBillboard(obj.Handle, "FruitESP", obj.Name .. " [" .. dist .. "m]", Color3.fromRGB(255, 50, 50))
                    esp.TextLabel.Text = obj.Name .. "\n" .. dist .. "m"
                elseif obj.Handle:FindFirstChild("FruitESP") then
                    obj.Handle.FruitESP:Destroy()
                end
            end
        end

        -- Flower ESP
        for _, obj in ipairs(Workspace:GetChildren()) do
            if (obj.Name == "Flower1" or obj.Name == "Flower2") and obj:IsA("BasePart") then
                if getgenv().FlowerESP then
                    local color = obj.Name == "Flower1" and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(255, 50, 50)
                    local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - obj.Position).Magnitude)
                    local esp = CreateBillboard(obj, "FlowerESP", obj.Name .. " [" .. dist .. "m]", color)
                    esp.TextLabel.Text = obj.Name .. "\n" .. dist .. "m"
                elseif obj:FindFirstChild("FlowerESP") then
                    obj.FlowerESP:Destroy()
                end
            end
        end

        -- Island ESP
        pcall(function()
            for _, loc in ipairs(Workspace._WorldOrigin.Locations:GetChildren()) do
                if loc.Name ~= "Sea" then
                    if getgenv().IslandESP then
                        local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - loc.Position).Magnitude)
                        local esp = CreateBillboard(loc, "IslandESP", loc.Name .. " [" .. dist .. "m]", Color3.fromRGB(80, 245, 245))
                        esp.TextLabel.Text = loc.Name .. "\n" .. dist .. "m"
                    elseif loc:FindFirstChild("IslandESP") then
                        loc.IslandESP:Destroy()
                    end
                end
            end
        end)

        -- Berry ESP
        for _, bush in ipairs(CollectionService:GetTagged("BerryBush")) do
            if getgenv().BerryESP and bush.Parent then
                local dist = math.floor((LocalPlayer.Character.HumanoidRootPart.Position - bush.Parent:GetPivot().Position).Magnitude)
                local esp = CreateBillboard(bush.Parent, "BerryESP", "Berry [" .. dist .. "m]", Color3.fromRGB(255, 255, 0))
                esp.TextLabel.Text = "Berry\n" .. dist .. "m"
            elseif bush.Parent and bush.Parent:FindFirstChild("BerryESP") then
                bush.Parent.BerryESP:Destroy()
            end
        end
    end
end)

