task.spawn(function()
    while task.wait(0.2) do
        pcall(function()
            -- Auto Boss Selected
            if getgenv().AutoBoss and getgenv().SelectBoss ~= "" then
                local b = Workspace.Enemies:FindFirstChild(getgenv().SelectBoss)
                if b and b:FindFirstChild("Humanoid") and b.Humanoid.Health > 0 and b:FindFirstChild("HumanoidRootPart") then
                    repeat
                        task.wait()
                        CheckAndEquipHaki()
                        EquipWeapon(getgenv().SelectWeapon)
                        topos(b.HumanoidRootPart.CFrame * CFrame.new(0, 30, 0))
                        VirtualUser:CaptureController()
                        VirtualUser:Button1Down(Vector2.new(1280, 672))
                    until not getgenv().AutoBoss or b.Humanoid.Health <= 0 or not b.Parent
                end
            end

            -- Katakuri / Dough King
            if getgenv().FarmCake then
                local boss = Workspace.Enemies:FindFirstChild("Cake Prince") or Workspace.Enemies:FindFirstChild("Dough King")
                if boss and boss:FindFirstChild("Humanoid") and boss.Humanoid.Health > 0 then
                    repeat
                        task.wait()
                        CheckAndEquipHaki()
                        EquipWeapon(getgenv().SelectWeapon)
                        topos(boss.HumanoidRootPart.CFrame * CFrame.new(0, 35, 0))
                        VirtualUser:CaptureController()
                        VirtualUser:Button1Down(Vector2.new(1280, 672))
                    until not getgenv().FarmCake or boss.Humanoid.Health <= 0
                end
            end

            -- Rip Indra
            if getgenv().RipIndraKill then
                local indra = Workspace.Enemies:FindFirstChild("rip_indra True Form") or Workspace.Enemies:FindFirstChild("rip_indra")
                if indra and indra:FindFirstChild("Humanoid") and indra.Humanoid.Health > 0 then
                    repeat
                        task.wait()
                        CheckAndEquipHaki()
                        EquipWeapon(getgenv().SelectWeapon)
                        topos(indra.HumanoidRootPart.CFrame * CFrame.new(0, -40, 0))
                        VirtualUser:CaptureController()
                        VirtualUser:Button1Down(Vector2.new(1280, 672))
                    until not getgenv().RipIndraKill or indra.Humanoid.Health <= 0
                end
            end

            -- Sea Events (Terrorshark / Shark / Piranha / Fish Crew)
            if getgenv().Autoterrorshark or getgenv().KillShark or getgenv().KillPiranha or getgenv().KillFishCrew then
                for _, seaMob in ipairs(Workspace.Enemies:GetChildren()) do
                    if (getgenv().Autoterrorshark and seaMob.Name == "Terrorshark")
                    or (getgenv().KillShark and seaMob.Name == "Shark")
                    or (getgenv().KillPiranha and seaMob.Name == "Piranha")
                    or (getgenv().KillFishCrew and seaMob.Name == "Fish Crew Member") then
                        if seaMob:FindFirstChild("Humanoid") and seaMob.Humanoid.Health > 0 and seaMob:FindFirstChild("HumanoidRootPart") then
                            repeat
                                task.wait()
                                CheckAndEquipHaki()
                                EquipWeapon(getgenv().SelectWeapon)
                                topos(seaMob.HumanoidRootPart.CFrame * CFrame.new(0, 45, 0))
                                VirtualUser:CaptureController()
                                VirtualUser:Button1Down(Vector2.new(1280, 672))
                            until seaMob.Humanoid.Health <= 0 or not seaMob.Parent
                        end
                    end
                end
            end
        end)
    end
end)

